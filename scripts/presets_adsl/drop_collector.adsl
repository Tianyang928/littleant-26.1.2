# Collect dropped cobblestone. It demonstrates a finite foreground task and
# cancellation on dangerous conditions.

@ai_start
def start():
    say("drop collector ready")
    last_drop = []

@tick_start
def collect():
    if is_on_fire() or health() <= 4:
        clear_goal()
        say("collector stopped: danger")
    else:
        if is_in_water() and not already_has_goal(better_float()):
            submit_background_goal(better_float(), 6, true(), false(), true())

        drop_pos = find_nearest_drop("minecraft:cobblestone")
        if drop_pos != [] and drop_pos != last_drop:
            # The remembered position prevents one move request per tick while
            # the asynchronous foreground movement is still running.
            last_drop = drop_pos
            move_to_blockpos(drop_pos)
