# Harvest the nearest oak log without flooding the foreground queue.
# Convention: slot 0 is reserved for food. The API has no reporter that finds
# the slot containing an arbitrary food item, so change FOOD_SLOT if needed.

@ai_start
def start():
    say("log harvester ready")
    last_log = []

@tick_start
def monitor():
    # Keep the ant afloat. better_float is a background goal so it can coexist
    # with the foreground harvesting goal; the guard prevents one per tick.
    if is_in_water() and not already_has_goal(better_float()):
        submit_background_goal(better_float(), 5, true(), false(), true())

    # Eat before the food bar is empty. Only use slot 0 when it is non-empty;
    # otherwise report the missing food instead of repeatedly submitting use.
    if food_level() <= 6:
        if get_item_count_in_inventory(0) > 0:
            switch_inventory_slot(0)
            eat_goal = use_item()
            if not already_has_goal(eat_goal):
                submit_foreground_goal(eat_goal)
        else:
            say("low food: put food in slot 0")

    # A fresh world query is made once, then the same position is reused.
    log_pos = find_nearest_block("minecraft:oak_log")
    if log_pos != [] and log_pos != last_log:
        break_goal = break_block_blockpos(log_pos)
        if not already_has_goal(break_goal):
            last_log = log_pos
            submit_foreground_goal(break_goal)
    else:
        say("no oak log in range")
