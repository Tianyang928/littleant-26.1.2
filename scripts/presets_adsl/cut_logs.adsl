@ai_start
def start():
    say("log harvester ready")
    last_log = []
    ignored_logs = []
    ignored_drops = []

@receive_goal
def eat_goal():
    for i in range(9):
        if is_in_tag(get_item_in_inventory(i),"meat") or get_item_in_inventory(i) == "minecraft:bread":
            switch_inventory_slot(i)
            submit_foreground_goal(use_item())
            break

def switch_to_axe():
    for i in range(9):
        if is_in_tag(get_item_in_inventory(i),"axes")
            switch_inventory_slot(i)

@receive_goal
def cut_log():
    log_target = find_block_list("logs",8)
    if log_target != []:
        ignored_num = 0
        for j in range(8):
            temp = get_list_value("log_target",j)
            if temp == "[]" or temp == "":
                continue()
            if contain_str(ignored_logs,temp):
                ignored_num = ignored_num + 1
                continue()
            add_value("ignored_logs",temp)
            submit_foreground_goal(break_block_blockpos(temp))

        if ignored_num == 8:
            move_to_xyz(x()+random(-16,16),y(),z()+random(-16,16))

def check_need_to_pick_up_drops():
    drop_target = find_drop_list("logs",8)
    if drop_target != []:
        for n in range(8):
            temp = get_list_value("drop_target",n)
            if temp == "[]" or temp == "":
                continue()
            if contain_str(ignored_logs,temp):
                continue()
            add_value("ignored_drops",temp)
            submit_background_goal("pick_up_drops", 4, true(), true(), false())

@receive_goal
def pick_up_drops():
    last_check_time = time()
    move_to_blockpos(get_list_value("drop_target",n))

@goal_tick_start
def pick_up_drops():
    if time()-last_check_time >= 10:
        last_check_time = time()
        for n in range(8):
            if distance_to_blockpos(get_list_value("drop_target",n)) <= 1.5:
                if get_list_value(get_list_value("drop_target",n),1) > y():
                    jump()
                break()

def check_need_to_put_to_chest:
    total_log_num = 0
    for t in range(9):
        if is_in_tag(get_item_in_inventory(t),"logs"):
            total_log_num = total_log_num + get_item_count_in_inventory(t)
    if total_log_num >= 64:
        chest_pos = find_nearest_block_entity("minecraft:chest")
        for t in range(9):
            if is_in_tag(get_item_in_inventory(t),"logs"):
                name = get_item_in_inventory(t)
                for s in range(27):
                    if get_item_in_container_blockpos(chest_pos,s) == name and get_item_count_in_container_blockpos(chest_pos,s) < 64:
                        submit_background_goal("put_to_chest", 3, true(), true(), false())
                    elif get_item_count_in_container_blockpos(chest_pos,s) == 0:
                        submit_background_goal("put_to_chest", 3, true(), true(), false())
@receive_goal
def put_to_chest():
    submit_foreground_goal(use_container_blockpos(chest_pos,true(),name,s,64))

@tick_start
def monitor():
    if is_in_water() and not already_has_goal(better_float()):
        submit_background_goal(better_float(), 1, false(), false(), true())

    if food_level() <= 6 and not already_has_goal("eat_goal"):
        submit_background_goal("eat_goal", 2, true(), false(), false())

    if not already_has_goal("eat_goal"):
        switch_to_axe()
    if not already_has_goal("put_to_chest") and not already_has_goal("cut_log") and not already_has_goal("pick_up_drops"):
        check_need_to_put_to_chest()
    if not already_has_goal("cut_log") and not already_has_goal("pick_up_drops"):
        check_need_to_pick_up_drops()
    if not already_has_goal("cut_log"):
        submit_background_goal("cut_log", 5, true(), true(), true())

