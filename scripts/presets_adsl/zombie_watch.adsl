# Reactive combat: attack one nearby zombie at a time and avoid duplicate goals.

@ai_start
def start():
    say("zombie watch ready")

@tick_start
def defend():
    if is_under_water() and not already_has_goal(better_float()):
        submit_background_goal(better_float(), 8, true(), false(), true())

    if food_level() <= 6:
        if get_item_count_in_inventory(0) > 0:
            switch_inventory_slot(0)
            eat_goal = use_item()
            if not already_has_goal(eat_goal):
                submit_foreground_goal(eat_goal)
        else:
            say("combat paused: food missing from slot 0")

    enemy = find_nearest_entity("minecraft:zombie")
    if enemy != "":
        attack_goal = melee_attack(enemy)
        if not already_has_goal(attack_goal):
            submit_foreground_goal(attack_goal)
